# AI summary (optional - falls back to rule-based analysis without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Paid vehicle-history provider (optional - without it the history section runs in DEMO mode)
# Must return JSON: { "events": [ { "date","type","country","detail","odometerKm","severity" } ] }
HISTORY_API_URL=https://your-provider.example.com/history?vin={vin}
HISTORY_API_KEY=
